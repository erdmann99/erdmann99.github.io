<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Teutonia Elsass-Lotgrillen</title>
  <link rel="icon" type="image/png" href="/images/image.png">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=fraunces:700,800|montserrat:400,500,600,700,800" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="page-<%= currentPage %>">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="Zur Startseite Teutonia Elsass-Lotgrillen">
        <img src="/images/image.png" alt="Wappen Teutonia Elsass-Lotgrillen">
        <span>
          <strong>Teutonia</strong>
          <small>Elsass-Lotgrillen</small>
        </span>
      </a>
      <button class="nav-toggle" aria-label="Navigation umschalten" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <ul>
          <% navItems.forEach((item) => { %>
            <li class="<%= currentPage === item.key ? 'active' : '' %>">
              <a href="<%= item.url %>"><%= item.label %></a>
            </li>
          <% }) %>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <%- include(template) %>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <img class="footer-crest" src="/images/image.png" alt="">
        <h3><%= site.name %></h3>
        <p>Offizielle Vereinsseite der Teutonia Elsass-Lotgrillen.</p>
      </div>
      <div>
        <h3>Vereinskontakt</h3>
        <address class="footer-address">
          <% site.postalAddress.forEach((line) => { %>
            <span><%= line %></span>
          <% }) %>
        </address>
        <p class="footer-note"><%= site.anniversary %> · gegründet im Mythos <%= site.founded %></p>
      </div>
      <div class="footer-links">
        <% navItems.forEach((item) => { %>
          <a href="<%= item.url %>"><%= item.label %></a>
        <% }) %>
      </div>
    </div>
    <p class="copyright">&copy; <span id="year"></span> <%= site.name %>. Alle Rechte vorbehalten, soweit der Spaß das zulässt.</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
