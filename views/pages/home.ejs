<section class="hero home-welcome">
  <div class="container hero-grid">
    <div class="home-welcome-copy">
      <p class="eyebrow">Offizielle Vereinsseite</p>
      <h1><%= home.hero.heading %></h1>
      <p class="lead"><%= home.hero.subheading %></p>
      <div class="hero-actions">
        <a class="button primary" href="/hymne">Vereinshymne</a>
        <a class="button secondary" href="#presse">Aktuellen Pressebericht lesen</a>
      </div>
    </div>
    <div class="hero-emblem" aria-label="Wappen und Grilltradition">
      <img class="hero-crest" src="/images/image.png" alt="Wappen Teutonia Elsass-Lotgrillen">
    </div>
  </div>
</section>

<section class="section history-section" id="historie" aria-labelledby="history-title">
  <div class="container split section-top">
    <div>
      <p class="eyebrow section-eyebrow">Historie</p>
      <h2 id="history-title">Zeitstrahl der Teutonia</h2>
    </div>
    <p>Ein kurzer Blick auf die wichtigsten Stationen des Vereins.</p>
  </div>

  <div class="container history-timeline">
    <% home.history.forEach((item) => { %>
      <article class="history-item">
        <time><%= item.year %></time>
        <h3><%= item.title %></h3>
        <p><%= item.text %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section press-section" id="presse" aria-labelledby="press-title">
  <div class="container split section-top">
    <div>
      <p class="eyebrow section-eyebrow">Presse</p>
      <h2 id="press-title">Aktueller Pressebericht</h2>
    </div>
    <p>Der neueste Bericht der Teutonia, direkt als Originaldokument.</p>
  </div>

  <a class="container press-card" href="<%= home.press.image %>" target="_blank" rel="noreferrer" aria-label="Pressebericht als Bild öffnen">
    <img src="<%= home.press.image %>" alt="<%= home.press.imageAlt %>">
    <span class="press-copy">
      <span class="home-news-meta"><%= home.press.date %></span>
      <strong><%= home.press.title %></strong>
      <span><%= home.press.summary %></span>
      <span class="read-more">Pressebericht öffnen</span>
    </span>
  </a>
</section>
